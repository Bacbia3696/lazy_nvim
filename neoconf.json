{
  "neoconf": {
    "plugins": {
      "lua_ls": {
        "enabled": true
      }
    }
  },
  "lspconfig": {
    "lua_ls": {
      "Lua.completion.callSnippet": "Replace"
    },
    "gopls": {
      "gopls": {
        "usePlaceholders": true,
        "hints": {
          "parameterNames": true
        },
        "analyses": {
          "fieldalignment": false
        }
      }
    }
  }
}
